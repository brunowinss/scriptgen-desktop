{
  "name": "scriptgen-desktop",
  "productName": "ScriptGen",
  "version": "1.0.0",
  "description": "ScriptGen para Windows: o mesmo site, com cópia dos vídeos e imagens prontos em Documentos/ScriptGen.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test media-store.test.cjs settings.test.cjs",
    "dist": "electron-builder --win --publish never",
    "portable": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.scriptgen.desktop",
    "productName": "ScriptGen",
    "files": [
      "main.cjs",
      "preload.cjs",
      "media-store.cjs",
      "settings.cjs",
      "updater.cjs",
      "site-version.json",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "brunowinss",
        "repo": "scriptgen-desktop",
        "releaseType": "release"
      }
    ],
    "artifactName": "ScriptGen-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ScriptGen"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "author": "ScriptGen",
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brunowinss/scriptgen-desktop.git"
  }
}
